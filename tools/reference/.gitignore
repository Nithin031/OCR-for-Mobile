# Model weights are downloaded by fetch_models.py; their sha256 is recorded in
# models/manifest.json, which IS committed together with the configs.
models/**/*.onnx
models/**/.cache/
# Android assets: .onnx files are large; regenerate with build_android_assets.py
android_assets/**/*.onnx
# Raw tensors from --save-tensors (large, regenerate on demand)
golden/**/*.npz
__pycache__/
.venv/
